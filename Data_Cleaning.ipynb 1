        "\n",
        "# OASIS INFOBYTE - DATA ANALYTICS\n",
        "# PROJECT 1: DATA CLEANING\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "print(\"DATA CLEANING PROJECT\")\n",
        "print(\"=\" * 45)\n",
        "\n",
        "# Step 1: Load the Titanic dataset\n",
        "url = \"https://raw.githubusercontent.com/datasciencedojo/datasets/master/titanic.csv\"\n",
        "df = pd.read_csv(url)\n",
        "\n",
        "print(\"\\n1. ORIGINAL DATASET\")\n",
        "print(\"Dataset shape:\", df.shape)\n",
        "print(\"\\nFirst five rows:\")\n",
        "print(df.head())\n",
        "\n",
        "# Step 2: Check data types and missing values\n",
        "print(\"\\n2. DATA TYPES\")\n",
        "print(df.dtypes)\n",
        "\n",
        "print(\"\\n3. MISSING VALUES BEFORE CLEANING\")\n",
        "print(df.isnull().sum())\n",
        "\n",
        "# Step 3: Check duplicate records\n",
        "print(\"\\n4. DUPLICATE RECORDS\")\n",
        "print(\"Duplicates:\", df.duplicated().sum())\n",
        "\n",
        "# Step 4: Remove duplicate records\n",
        "df = df.drop_duplicates()\n",
        "\n",
        "# Step 5: Handle missing values\n",
        "# Fill Age with median\n",
        "df[\"Age\"] = df[\"Age\"].fillna(df[\"Age\"].median())\n",
        "\n",
        "# Fill Embarked with most common value\n",
        "df[\"Embarked\"] = df[\"Embarked\"].fillna(\n",
        "    df[\"Embarked\"].mode()[0]\n",
        ")\n",
        "\n",
        "# Remove Cabin because many values are missing\n",
        "df = df.drop(columns=[\"Cabin\"])\n",
        "\n",
        "# Step 6: Standardise text values\n",
        "df[\"Sex\"] = df[\"Sex\"].str.strip().str.lower()\n",
        "df[\"Embarked\"] = df[\"Embarked\"].str.strip().str.upper()\n",
        "\n",
        "# Step 7: Check outliers using IQR\n",
        "Q1 = df[\"Fare\"].quantile(0.25)\n",
        "Q3 = df[\"Fare\"].quantile(0.75)\n",
        "IQR = Q3 - Q1\n",
        "\n",
        "lower_limit = Q1 - 1.5 * IQR\n",
        "upper_limit = Q3 + 1.5 * IQR\n",
        "\n",
        "outliers = df[\n",
        "    (df[\"Fare\"] < lower_limit) |\n",
        "    (df[\"Fare\"] > upper_limit)\n",
        "]\n",
        "\n",
        "print(\"\\n5. OUTLIER ANALYSIS\")\n",
        "print(\"Fare outliers detected:\", len(outliers))\n",
        "print(\"Outliers are reported, not automatically deleted.\")\n",
        "\n",
        "# Step 8: Correct data types\n",
        "df[\"Pclass\"] = df[\"Pclass\"].astype(\"int64\")\n",
        "df[\"Survived\"] = df[\"Survived\"].astype(\"int64\")\n",
        "\n",
        "# Step 9: Check missing values after cleaning\n",
        "print(\"\\n6. MISSING VALUES AFTER CLEANING\")\n",
        "print(df.isnull().sum())\n",
        "\n",
        "# Step 10: Before and after summary\n",
        "print(\"\\n7. CLEANED DATASET\")\n",
        "print(\"Final shape:\", df.shape)\n",
        "print(\"\\nFinal data types:\")\n",
        "print(df.dtypes)\n",
        "\n",
        "# Step 11: Visualise missing values\n",
        "before_missing = pd.read_csv(url).isnull().sum()\n",
        "after_missing = df.isnull().sum()\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "before_missing.plot(kind=\"bar\", alpha=0.7, label=\"Before cleaning\")\n",
        "after_missing.reindex(before_missing.index, fill_value=0).plot(\n",
        "    kind=\"bar\", alpha=0.7, label=\"After cleaning\"\n",
        ")\n",
        "plt.title(\"Missing Values: Before vs After Cleaning\")\n",
        "plt.xlabel(\"Columns\")\n",
        "plt.ylabel(\"Number of Missing Values\")\n",
        "plt.legend()\n",
        "plt.xticks(rotation=45)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Step 12: Save cleaned dataset\n",
        "df.to_csv(\"cleaned_titanic_data.csv\", index=False)\n",
        "\n",
        "print(\"\\n8. PROJECT COMPLETED\")\n",
        "print(\"Cleaned dataset saved as cleaned_titanic_data.csv\")\n"
